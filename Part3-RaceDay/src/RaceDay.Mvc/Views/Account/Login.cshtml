@model RaceDay.Mvc.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="rd-card rd-card-body rd-auth-card">
    <h1 class="rd-section-title">Log in to RaceDay</h1>

    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">Email address</label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <fieldset class="mb-4">
            <legend class="form-label fw-semibold fs-6">I am signing in as</legend>
            <div class="d-flex gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Role" value="Participant" id="roleParticipant" />
                    <label class="form-check-label" for="roleParticipant">Participant</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Role" value="Organiser" id="roleOrganiser" />
                    <label class="form-check-label" for="roleOrganiser">Organiser</label>
                </div>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-rd w-100 mb-3">Log in</button>
    </form>

    <p class="text-center mb-2">
        New to RaceDay? <a asp-controller="Account" asp-action="Register">Create an account</a>
    </p>

    <div class="alert alert-light border small mb-0">
        <strong>Demo accounts</strong> (password: <code>Password123!</code>)<br />
        Participant: <code>participant@raceday.co.za</code><br />
        Organiser: <code>organiser@raceday.co.za</code>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
