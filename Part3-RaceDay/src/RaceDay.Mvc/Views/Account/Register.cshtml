@model RaceDay.Mvc.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="rd-card rd-card-body rd-auth-card">
    <h1 class="rd-section-title">Create your RaceDay account</h1>

    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label fw-semibold"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3 mt-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <fieldset class="mt-3 mb-4">
            <legend class="form-label fw-semibold fs-6">Register as</legend>
            <div class="d-flex gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Role" value="Participant" id="regParticipant" />
                    <label class="form-check-label" for="regParticipant">Participant &mdash; enter events</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Role" value="Organiser" id="regOrganiser" />
                    <label class="form-check-label" for="regOrganiser">Organiser &mdash; create events</label>
                </div>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-rd w-100 mb-3">Create account</button>
    </form>

    <p class="text-center mb-0">
        Already registered? <a asp-controller="Account" asp-action="Login">Log in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
