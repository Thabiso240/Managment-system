@model IEnumerable<RaceDay.Mvc.Models.EventDto>
@{
    ViewData["Title"] = "Find your next race";
    var filter = ViewBag.Filter as RaceDay.Mvc.Models.EventFilterViewModel ?? new RaceDay.Mvc.Models.EventFilterViewModel();
}

<section class="rd-hero mb-4">
    <h1>Find your next race</h1>
    <p>Browse every event on RaceDay, compare distances and venues, and secure your place in seconds.</p>
    <a class="btn btn-rd btn-lg" asp-controller="Account" asp-action="Register">Join RaceDay</a>
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="rd-card rd-card-body mb-4" role="search" aria-label="Filter events">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="search" class="form-label fw-semibold">Search</label>
            <input type="search" class="form-control" id="search" name="search" value="@filter.Search"
                   placeholder="Event name or venue" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label fw-semibold">Event type</label>
            <select class="form-select" id="type" name="type">
                <option value="">All types</option>
                @foreach (var t in RaceDay.Mvc.Models.EventTypes.All)
                {
                    <option value="@t" selected="@(filter.Type == t)">@RaceDay.Mvc.Models.EventTypes.Label(t)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="location" class="form-label fw-semibold">Location</label>
            <input type="text" class="form-control" id="location" name="location" value="@filter.Location"
                   placeholder="City or province" />
        </div>
        <div class="col-md-2 d-flex flex-column gap-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="upcomingOnly" name="upcomingOnly" value="true"
                       checked="@filter.UpcomingOnly" />
                <label class="form-check-label" for="upcomingOnly">Upcoming only</label>
            </div>
            <button type="submit" class="btn btn-rd">Filter</button>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0 fw-bold">@Model.Count() event@(Model.Count() == 1 ? "" : "s") found</h2>
</div>

@if (!Model.Any())
{
    <div class="rd-card rd-empty">
        <p class="mb-1 fw-semibold">No events match your search.</p>
        <p class="mb-0">Try clearing the filters or searching for a different venue.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="rd-card rd-event-card">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="rd-event-banner" alt="Banner image for @ev.Name" />
                    }
                    else
                    {
                        <div class="rd-event-banner-placeholder" aria-hidden="true">RACEDAY</div>
                    }
                    <div class="rd-card-body d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h3 class="rd-event-title">@ev.Name</h3>
                            <span class="rd-type-pill">@RaceDay.Mvc.Models.EventTypes.Label(ev.EventType)</span>
                        </div>
                        <div class="rd-meta">
                            <span>@ev.Date.ToString("ddd dd MMM yyyy")</span>
                            <span>@ev.Location</span>
                            <span>@ev.DistanceKm.ToString("0.#") km</span>
                        </div>
                        <p class="text-muted small flex-grow-1">@(ev.Description.Length > 120 ? ev.Description.Substring(0, 120) + "..." : ev.Description)</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="rd-label-hint">@ev.CategoryCount categor@(ev.CategoryCount == 1 ? "y" : "ies") &middot; @ev.EnrolmentCount entries</span>
                            <a class="btn btn-rd btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id">View details</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
