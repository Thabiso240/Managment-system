@model IReadOnlyList<RaceDay.Mvc.Models.CategoryDto>
@{
    var ev = ViewBag.Event as RaceDay.Mvc.Models.EventDetailDto;
    var newCategory = ViewBag.NewCategory as RaceDay.Mvc.Models.CategoryFormViewModel ?? new RaceDay.Mvc.Models.CategoryFormViewModel();
    ViewData["Title"] = "Categories";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Organiser" asp-action="Events">Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">Categories</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="rd-section-title mb-1">Categories</h1>
        <p class="text-muted mb-0">@ev?.Name &middot; @ev?.Location &middot; @ev?.Date.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-rd-outline" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@ev?.Id">Enrolments</a>
        <a class="btn btn-rd-dark" asp-controller="Organiser" asp-action="Results" asp-route-id="@ev?.Id">Results entry</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card">
            <div class="rd-card-body pb-0">
                <h2 class="h5 fw-bold">Existing categories</h2>
            </div>

            @if (!Model.Any())
            {
                <div class="rd-empty">
                    <p class="mb-0">No categories yet. Add the first one using the form alongside.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Age group</th>
                                <th scope="col">Distance</th>
                                <th scope="col">Fee</th>
                                <th scope="col" class="text-center">Entries</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@category.Name</td>
                                    <td>@(category.AgeGroup ?? "—")</td>
                                    <td>@(category.DistanceKm.HasValue ? category.DistanceKm.Value.ToString("0.#") + " km" : "—")</td>
                                    <td>@(category.EntryFee.HasValue ? "R " + category.EntryFee.Value.ToString("0.00") : "—")</td>
                                    <td class="text-center">
                                        @category.EnrolmentCount@(category.MaxEntries.HasValue ? $" / {category.MaxEntries}" : "")
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-rd-outline" data-bs-toggle="modal"
                                                data-bs-target="#editCategory-@category.Id">Edit</button>
                                        <form asp-controller="Organiser" asp-action="DeleteCategory" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove the category @category.Name?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <input type="hidden" name="eventId" value="@category.EventId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card rd-card-body">
            <h2 class="h5 fw-bold mb-3">Add a category</h2>

            <form asp-controller="Organiser" asp-action="AddCategory" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="EventId" value="@newCategory.EventId" />

                <div class="mb-3">
                    <label for="Name" class="form-label fw-semibold">Category name</label>
                    <input id="Name" name="Name" class="form-control" placeholder="e.g. Senior Male 42km" required />
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label for="AgeGroup" class="form-label fw-semibold">Age group</label>
                        <input id="AgeGroup" name="AgeGroup" class="form-control" placeholder="18-39" />
                    </div>
                    <div class="col-6">
                        <label for="DistanceKm" class="form-label fw-semibold">Distance (km)</label>
                        <input id="DistanceKm" name="DistanceKm" type="number" step="0.1" min="0" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label for="EntryFee" class="form-label fw-semibold">Entry fee (R)</label>
                        <input id="EntryFee" name="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label for="MaxEntries" class="form-label fw-semibold">Maximum entries</label>
                        <input id="MaxEntries" name="MaxEntries" type="number" min="1" class="form-control" />
                    </div>
                </div>

                <button type="submit" class="btn btn-rd w-100 mt-4">Add category</button>
            </form>
        </div>
    </div>
</div>

@foreach (var category in Model)
{
    <div class="modal fade" id="editCategory-@category.Id" tabindex="-1" aria-labelledby="editCategoryLabel-@category.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Organiser" asp-action="EditCategory" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@category.Id" />
                    <input type="hidden" name="EventId" value="@category.EventId" />

                    <div class="modal-header">
                        <h2 class="modal-title h5" id="editCategoryLabel-@category.Id">Edit category</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="edit-name-@category.Id">Category name</label>
                            <input class="form-control" id="edit-name-@category.Id" name="Name" value="@category.Name" required />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="edit-age-@category.Id">Age group</label>
                                <input class="form-control" id="edit-age-@category.Id" name="AgeGroup" value="@category.AgeGroup" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="edit-dist-@category.Id">Distance (km)</label>
                                <input class="form-control" id="edit-dist-@category.Id" name="DistanceKm" type="number" step="0.1" value="@category.DistanceKm" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="edit-fee-@category.Id">Entry fee (R)</label>
                                <input class="form-control" id="edit-fee-@category.Id" name="EntryFee" type="number" step="0.01" value="@category.EntryFee" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold" for="edit-max-@category.Id">Maximum entries</label>
                                <input class="form-control" id="edit-max-@category.Id" name="MaxEntries" type="number" value="@category.MaxEntries" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-rd">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
