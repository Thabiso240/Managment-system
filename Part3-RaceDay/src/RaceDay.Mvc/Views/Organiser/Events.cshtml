@model IEnumerable<RaceDay.Mvc.Models.EventDto>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="rd-section-title mb-0">Manage Events</h1>
    <a class="btn btn-rd" asp-controller="Organiser" asp-action="CreateEvent">Create event</a>
</div>

@if (!Model.Any())
{
    <div class="rd-card rd-empty">
        <p class="mb-3">You have not created any events yet.</p>
        <a class="btn btn-rd" asp-controller="Organiser" asp-action="CreateEvent">Create your first event</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Type</th>
                        <th scope="col">Distance</th>
                        <th scope="col" class="text-center">Categories</th>
                        <th scope="col" class="text-center">Entries</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@ev.Name</span>
                                <span class="d-block small text-muted">@ev.Location</span>
                            </td>
                            <td>@ev.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="rd-type-pill">@RaceDay.Mvc.Models.EventTypes.Label(ev.EventType)</span></td>
                            <td>@ev.DistanceKm.ToString("0.#") km</td>
                            <td class="text-center">@ev.CategoryCount</td>
                            <td class="text-center">@ev.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-rd-outline" asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@ev.Id">Edit</a>
                                <a class="btn btn-sm btn-rd-outline" asp-controller="Organiser" asp-action="Categories" asp-route-id="@ev.Id">Categories</a>
                                <a class="btn btn-sm btn-rd-outline" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@ev.Id">Enrolments</a>
                                <a class="btn btn-sm btn-rd-dark" asp-controller="Organiser" asp-action="Results" asp-route-id="@ev.Id">Results</a>
                                <form asp-controller="Organiser" asp-action="DeleteEvent" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @ev.Name? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ev.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
